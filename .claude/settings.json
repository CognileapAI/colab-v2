{
  "effortLevel": "high",
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bootstrap-diet.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "lane-worker",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-setup.sh\""
          }
        ]
      }
    ]
  }
}
