# CoLAB v2 staging 백업 설정 — 예시.
# 실값은 레포 밖 홈 파일 `.colab-v2-staging-backup.env` (권한 0600) 에 둔다.
# 이 파일에는 비밀을 적지 않는다. 아래는 전부 placeholder 다.

# 백업 대상 종류: none | postgres
#   none     = 아직 저장소가 없다. backup.sh 는 성공하지 않고 exit 78 로 큰 소리를 낸다.
#   postgres = I2 walking skeleton 이 postgres 를 올린 뒤 이 한 줄만 바꾸면 붙는다.
COLAB_BACKUP_TARGET=none

# 프로파일 — 체인이 분리이므로(CLAUDE.md §3-3) 백업도 분리다.
# 한 산출물이 두 데이터베이스를 덮는 척하지 않는다. 하나라도 실패하면 전체가 실패다.
COLAB_BACKUP_PROFILES="platform ai"
#
# ⭑ **최소 행 수 = 현재 실측의 절반** (`PLAN-SoT §9 〈128〉` 집행 · 2026-08-27).
#   종전 값은 platform `1` · ai `23` 이었다 — **행이 거의 다 날아가도 통과한다.**
#   PoC 사고가 「20바이트 빈 gzip 을 8주 내내 성공으로 기록」이었고, 막아야 하는 것은
#   **거의 빈 덤프**이지 소폭 변동이 아니다.
#   실측(staging, 2026-08-27) — platform **381행** · ai **91행**. 그 절반을 합격선으로 둔다.
#   절반인 이유 하나 더 — **데이터가 늘면 자동으로 더 보수적이 된다.** 자주 갱신할 필요가 없다.
#   **갱신 주기 = 실측이 두 배가 되면 다시 올린다**(그때 합격선이 다시 절반이 된다).
#   ⚠ 이 값이 **실제로 막는지**를 확인하고 올렸다 — 합격선 100000 으로 걸면
#   `C5 … < 100000` 로 **RED(exit 1)** 가 난다. 통과만 보고 끝내면 그건 가드가 아니다.
COLAB_BACKUP_DB_platform=
COLAB_BACKUP_MIN_TABLES_platform=20
COLAB_BACKUP_MIN_ROWS_platform=190
COLAB_BACKUP_DB_ai=
COLAB_BACKUP_MIN_TABLES_ai=4
COLAB_BACKUP_MIN_ROWS_ai=45

# TARGET=postgres 일 때만 읽는다. 둘 중 하나를 채운다.
#   (COLAB_BACKUP_PG_DB 는 프로파일을 안 쓰는 구 단일대상 설정용이다)
#   컨테이너 경유(권장 — 호스트 포트를 열지 않는다)
COLAB_BACKUP_PG_CONTAINER=
COLAB_BACKUP_PG_DB=
COLAB_BACKUP_PG_USER=
#   또는 URL 직결 (호스트에 psql/pg_dump 가 있을 때)
COLAB_BACKUP_PG_URL=

# 산출물 보관처 — 레포 밖이어야 한다. 기본값은 홈 아래.
COLAB_BACKUP_DIR=

# 합격선. 스키마 정본(db/platform/schema.sql)의 테이블 수를 밑돌면 red.
COLAB_BACKUP_MIN_TABLES=20
# 데이터 행이 최소 이만큼은 복원돼야 한다. 0 으로 두면 "빈 DB 도 통과" 가 되므로 1 이상.
COLAB_BACKUP_MIN_ROWS=1
# 산출물 신선도 상한(분). 이보다 오래된 파일은 "오늘 백업이 돌았다"의 증거가 아니다.
COLAB_BACKUP_MAX_AGE_MIN=1500
# 보존 일수. 가장 최신 1개는 어떤 경우에도 지우지 않는다.
COLAB_BACKUP_RETENTION_DAYS=14
