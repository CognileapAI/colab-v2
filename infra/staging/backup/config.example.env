# CoLAB v2 staging 백업 설정 — 예시.
# 실값은 레포 밖 홈 파일 `.colab-v2-staging-backup.env` (권한 0600) 에 둔다.
# 이 파일에는 비밀을 적지 않는다. 아래는 전부 placeholder 다.

# 백업 대상 종류: none | postgres
#   none     = 아직 저장소가 없다. backup.sh 는 성공하지 않고 exit 78 로 큰 소리를 낸다.
#   postgres = I2 walking skeleton 이 postgres 를 올린 뒤 이 한 줄만 바꾸면 붙는다.
COLAB_BACKUP_TARGET=none

# TARGET=postgres 일 때만 읽는다. 둘 중 하나를 채운다.
#   컨테이너 경유(권장 — 호스트 포트를 열지 않는다)
COLAB_BACKUP_PG_CONTAINER=
COLAB_BACKUP_PG_DB=
COLAB_BACKUP_PG_USER=
#   또는 URL 직결 (호스트에 psql/pg_dump 가 있을 때)
COLAB_BACKUP_PG_URL=

# 산출물 보관처 — 레포 밖이어야 한다. 기본값은 홈 아래.
COLAB_BACKUP_DIR=

# 합격선. 스키마 정본(db/platform/schema.sql)의 테이블 수를 밑돌면 red.
COLAB_BACKUP_MIN_TABLES=20
# 데이터 행이 최소 이만큼은 복원돼야 한다. 0 으로 두면 "빈 DB 도 통과" 가 되므로 1 이상.
COLAB_BACKUP_MIN_ROWS=1
# 산출물 신선도 상한(분). 이보다 오래된 파일은 "오늘 백업이 돌았다"의 증거가 아니다.
COLAB_BACKUP_MAX_AGE_MIN=1500
# 보존 일수. 가장 최신 1개는 어떤 경우에도 지우지 않는다.
COLAB_BACKUP_RETENTION_DAYS=14
