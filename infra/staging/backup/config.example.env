# CoLAB v2 staging 백업 설정 — 예시.
# 실값은 레포 밖 홈 파일 `.colab-v2-staging-backup.env` (권한 0600) 에 둔다.
# 이 파일에는 비밀을 적지 않는다. 아래는 전부 placeholder 다.

# 백업 대상 종류: none | postgres
#   none     = 아직 저장소가 없다. backup.sh 는 성공하지 않고 exit 78 로 큰 소리를 낸다.
#   postgres = I2 walking skeleton 이 postgres 를 올린 뒤 이 한 줄만 바꾸면 붙는다.
COLAB_BACKUP_TARGET=none

# 프로파일 — 체인이 분리이므로(CLAUDE.md §3-3) 백업도 분리다.
# 한 산출물이 두 데이터베이스를 덮는 척하지 않는다. 하나라도 실패하면 전체가 실패다.
COLAB_BACKUP_PROFILES="platform ai"
#
# ⭑ **최소 행 수 = 현재 실측의 절반** (`PLAN-SoT §9 〈128〉` 집행 · 2026-08-27).
#   종전 값은 platform `1` · ai `23` 이었다 — **행이 거의 다 날아가도 통과한다.**
#   PoC 사고가 「20바이트 빈 gzip 을 8주 내내 성공으로 기록」이었고, 막아야 하는 것은
#   **거의 빈 덤프**이지 소폭 변동이 아니다.
#   실측(staging, 2026-08-27) — platform **381행** · ai **91행**. 그 절반을 합격선으로 둔다.
#   절반인 이유 하나 더 — **데이터가 늘면 자동으로 더 보수적이 된다.** 자주 갱신할 필요가 없다.
#   **갱신 주기 = 실측이 두 배가 되면 다시 올린다**(그때 합격선이 다시 절반이 된다).
#   ⚠ 이 값이 **실제로 막는지**를 확인하고 올렸다 — 합격선 100000 으로 걸면
#   `C5 … < 100000` 로 **RED(exit 1)** 가 난다. 통과만 보고 끝내면 그건 가드가 아니다.
#   ⚠ **기본값은 이제 `lib.sh` 안에 있다** (`〈171〉-㉯`). 이 파일에 안 적어도 platform 190/20 · ai 45/4 로 돈다.
#     그리고 **선언이 아예 없는 프로파일은 전역 `#   ⚠ 이 전역 둘은 `verify-artifact.sh` 를 **손으로 한 파일에 대고** 돌릴 때 쓰는 값이다.
#     프로파일 경로는 이 값으로 떨어지지 않는다(`〈171〉-㉯`).
COLAB_BACKUP_MIN_ROWS=1` 로 떨어지지 않고 C0 에서 RED** 다.
COLAB_BACKUP_DB_platform=
COLAB_BACKUP_MIN_TABLES_platform=20
COLAB_BACKUP_MIN_ROWS_platform=190
COLAB_BACKUP_DB_ai=
COLAB_BACKUP_MIN_TABLES_ai=4
COLAB_BACKUP_MIN_ROWS_ai=45

# TARGET=postgres 일 때만 읽는다. 둘 중 하나를 채운다.
#   (COLAB_BACKUP_PG_DB 는 프로파일을 안 쓰는 구 단일대상 설정용이다)
#   컨테이너 경유(권장 — 호스트 포트를 열지 않는다)
COLAB_BACKUP_PG_CONTAINER=
COLAB_BACKUP_PG_DB=
COLAB_BACKUP_PG_USER=
#   또는 URL 직결 (호스트에 psql/pg_dump 가 있을 때)
COLAB_BACKUP_PG_URL=

# 산출물 보관처 — 레포 밖이어야 한다. 기본값은 홈 아래.
COLAB_BACKUP_DIR=

# 합격선. 스키마 정본(db/platform/schema.sql)의 테이블 수를 밑돌면 red.
COLAB_BACKUP_MIN_TABLES=20
# 데이터 행이 최소 이만큼은 복원돼야 한다. 0 으로 두면 "빈 DB 도 통과" 가 되므로 1 이상.
COLAB_BACKUP_MIN_ROWS=1
# 산출물 신선도 상한(분). 이보다 오래된 파일은 "오늘 백업이 돌았다"의 증거가 아니다.
COLAB_BACKUP_MAX_AGE_MIN=1500
# 보존 일수. 가장 최신 1개는 어떤 경우에도 지우지 않는다.
COLAB_BACKUP_RETENTION_DAYS=14

# ── 볼륨 아카이브 (2026-08-27 · R-1) ─────────────────────────────────────────
# 원장 덤프와 **다른 산출물**이다. 이름은 `vol-<볼륨>-<타임스탬프>.tar.gz` 이고
# 같은 이름의 `.manifest.tsv`(경로·크기·sha256) · `.pair`(짝 원장 덤프 파일명) · `.sha256` 이 붙는다.
COLAB_VOLBACKUP_PROJECT=colab-v2-staging
# `compose.i2.yml` 의 named volume 은 **정확히 둘**이다 — `uploads` · `previews`.
# postgres 는 named volume 이 아니라 **바인드 마운트**라 여기 없다(논리 덤프로 덮는다).
COLAB_VOLBACKUP_VOLUMES="uploads previews"
COLAB_VOLBACKUP_HELPER_IMAGE=alpine:3.20

# 볼륨별 합격선 — `F9` 가 원장 프로파일에 세운 것과 같은 형태다.
#   ⭑ **[미확인] 이 닫혔다** (`R1-REHEARSAL-01 §2.2` · 2026-08-27 실측 — uploads 135건 · previews 39건).
#     합격선 = 실측의 **절반**(uploads **67** · previews **19**). 근거는 원장 쪽과 같다(`〈128〉`):
#     막아야 하는 것은 「거의 빈 아카이브」이지 소폭 변동이 아니고, 절반이면 **데이터가 늘수록
#     자동으로 보수적**이 되어 자주 갱신할 필요가 없다. 갱신 주기 = 실측이 두 배가 되면 다시 올린다.
#   ⚠ **기본값은 이제 `volume-lib.sh` 안에 있다.** 이 파일에 안 적어도 67·19 로 돈다 —
#     1회차에 이 키가 실 설정에 없어 기본 `1` 로 돌던 것이 `〈170〉-㉳` 의 발단이다.
#   ⭑ **값은 세 상태다** (`〈171〉-㉮` · 오라클과 대칭). `<숫자>`=합격선 · `none`=**명시 면제**(승인된 SKIP) ·
#     **빈 값·미설정=RED.** 종전에는 미선언이 조용히 합격선 `1` 이 됐고, 그것은 `ORACLE_<볼륨>=none` 이라는
#     정당한 면제 하나로 되살아나는 결함이었다 — V5 는 승인된 SKIP, V6 는 합격선 1.
COLAB_VOLBACKUP_MIN_FILES_uploads=67
COLAB_VOLBACKUP_MIN_FILES_previews=19

# 오라클 — 아카이브를 **원장과 대조**할 기준 테이블. 값은 **세 상태**다(`volume_oracle` 주석).
#   `uploads` 는 `d3_file.storage_key` 가 곧 볼륨 안 상대 경로다
#   (`contracts/storage/layout.json` — 저장 키가 곧 배치).
#   `previews` 는 원장에 대응 표가 없다 → **`none` 이라 적는다.** 비워 두면 **RED** 다.
#   ⚠ **기본값은 `volume-lib.sh` 안에 있다** (`〈170〉-㉮`). 이 파일에 안 적어도 오라클은 켜져 있다 —
#     1회차의 green-by-skip 이 「실 설정 파일에 키가 없었다」는 단 하나의 이유로 났기 때문이다.
#     **손으로 켜야 도는 검사는 검사가 아니다.**
COLAB_VOLBACKUP_ORACLE_uploads=d3_file
COLAB_VOLBACKUP_ORACLE_previews=none

# 보존 — 원장 덤프(14일)와 **따로** 둔다. 근거는 README 「보존 정책과 그 근거」.
COLAB_VOLBACKUP_RETENTION_DAYS=3
# 디스크 여유 사전점검 배수. 볼륨 실사용 x 이 값만큼 보관처에 안 남아 있으면 시작하지 않는다.
COLAB_VOLBACKUP_FREE_MULTIPLIER=3
# 볼륨 아카이브 신선도 상한(분). 비우면 COLAB_BACKUP_MAX_AGE_MIN 을 따라간다.
COLAB_VOLBACKUP_MAX_AGE_MIN=1500

# ── 보관처 위생 (`〈170〉-㉰` · Ted 판정 2026-08-27) ───────────────────────────
# **보관처에는 산출물만 둔다.** `backup-full.sh` 0단 · `latest-check.sh` · `preflight P10` 이
# 허용 목록(`<프로파일>-<stamp>.sql.gz` · `vol-*.tar.gz` · `.manifest.tsv` · `.pair` · `.sha256` · `.inflight-*`)
# 밖의 파일을 발견하면 **RED** 를 낸다. 비밀 7종의 사본을 여기 두지 않는다 — 설정 항목이 아니라 **규칙**이다.
