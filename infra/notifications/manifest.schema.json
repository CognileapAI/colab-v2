{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "environment",
    "usage",
    "channels",
    "coverage_started_at",
    "test_exclusions",
    "sources",
    "probes"
  ],
  "properties": {
    "schema": {
      "const": "colab.operator-manifest/1"
    },
    "environment": {
      "enum": [
        "dev",
        "staging"
      ]
    },
    "usage": {
      "enum": [
        "live",
        "rehearsal"
      ]
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "activity"
      ],
      "properties": {
        "development": {
          "type": "string",
          "minLength": 1
        },
        "activity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "test_exclusions": {
      "type": "object",
      "required": [
        "lab_ids",
        "account_ids",
        "effective_at"
      ],
      "properties": {
        "lab_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "account_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "d2",
          "d3",
          "d5",
          "d6",
          "d8"
        ]
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "target",
          "command",
          "timeout"
        ],
        "properties": {
          "target": {
            "enum": [
              "service-health",
              "backup-freshness",
              "deploy-verification"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          }
        }
      }
    }
  }
}
