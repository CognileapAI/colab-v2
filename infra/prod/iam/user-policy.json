{
  "_comment": "운영자 사용자 colab-platform-s3-uploader-prod(장기 키, 로컬 도구 전용 — s3_doctor·s3_smoke·deploy_doctor·deploy_web). 데이터 버킷 3문 + 웹 버킷 Put/List/Delete. EC2 에는 이 키를 넣지 않는다(인스턴스 프로파일이 준다). ⚠ 와일드카드 금지 — `…-data-*` 로 쓰면 dev 열쇠가 prod 를 연다. ＋ GetBucketTagging 을 더했다(2026-09-06): dev 정책에 없어서 비용 할당 태그를 도구로 검증할 수 없었다 — 붙였는지 눈으로만 확인해야 했다. 〈343〉-㉲",
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "DataBucketOps", "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket",
                 "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::colab-platform-data-prod", "arn:aws:s3:::colab-platform-data-prod/*"] },
    { "Sid": "DataBucketDiagnostics", "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:GetBucketCors", "s3:GetLifecycleConfiguration",
                 "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration", "s3:GetBucketPolicy",
                 "s3:GetBucketTagging"],
      "Resource": "arn:aws:s3:::colab-platform-data-prod" },
    { "Sid": "WebBucketDeploy", "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::colab-platform-web-prod", "arn:aws:s3:::colab-platform-web-prod/*"] },
    { "Sid": "WebBucketDiagnostics", "Effect": "Allow",
      "Action": ["s3:GetBucketTagging"],
      "Resource": "arn:aws:s3:::colab-platform-web-prod" },
    { "Sid": "Identity", "Effect": "Allow", "Action": "sts:GetCallerIdentity", "Resource": "*" }
  ]
}
