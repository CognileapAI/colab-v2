{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colab.cognileap.ai/schemas/knowledge-lifecycle.json",
  "title": "Knowledge lifecycle internal values v1",
  "description": "Strict wire values, not authentication. Grant verification, source authority, authorization and receipt issuer authentication are adapter responsibilities. Bounds are per-source payload safety limits, not throughput SLA.",
  "$defs": {
    "Id": {"$ref": "common.json#/$defs/Ulid"},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Version": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
    "ConceptId": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Manifest key without concept: prefix; codegen checks its length and grammar against core-ai OntologyManifest."},
    "SourceKey": {
      "type": "object", "additionalProperties": false,
      "required": ["lab_id", "dataset_id", "source_kind", "source_id"],
      "properties": {
        "lab_id": {"$ref": "#/$defs/Id"}, "dataset_id": {"$ref": "#/$defs/Id"},
        "source_kind": {"enum": ["metadata", "file", "evidence", "lineage"]},
        "source_id": {"$ref": "#/$defs/Id"}
      }
    },
    "SourceVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "digest", "deleted"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/Digest"}, "deleted": {"type": "boolean"}
      }
    },
    "ProcessingVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "extractor_version", "mapping_version", "ontology_release"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "extractor_version": {"$ref": "#/$defs/Version"},
        "mapping_version": {"$ref": "#/$defs/Version"},
        "ontology_release": {"$ref": "#/$defs/Digest"}
      }
    },
    "Principal": {
      "description": "Authenticated adapter binds these claims. Caller-provided IDs are not authority.",
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "lab_id", "session_version"],
      "properties": {"account_id": {"$ref": "#/$defs/Id"}, "lab_id": {"$ref": "#/$defs/Id"},
                     "session_version": {"type": "integer", "minimum": 1}}
    },
    "Evidence": {
      "description": "Predicate and value must be one field of the existing SearchEvidenceFacts contract. Cross-field predicate typing is enforced by generated DTOs. Raw metadata is not automatically confirmed evidence.",
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "predicate", "value", "source_locator", "source_version", "evidence_kind"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/Id"},
        "predicate": {"type": "string"}, "value": {},
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 300},
        "source_version": {"$ref": "#/$defs/SourceVersion"},
        "evidence_kind": {"enum": ["file_measurement", "description_claim", "human_review"]}
      },
      "oneOf": [
        {"properties": {"predicate": {"const": "representation"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/representation"}}},
        {"properties": {"predicate": {"const": "platform"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/platform"}}},
        {"properties": {"predicate": {"const": "format"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/format"}}},
        {"properties": {"predicate": {"const": "provider"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/provider"}}},
        {"properties": {"predicate": {"const": "unit"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/unit"}}},
        {"properties": {"predicate": {"const": "statistics"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/statistics"}}},
        {"properties": {"predicate": {"const": "roles"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/roles"}}},
        {"properties": {"predicate": {"const": "period"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/period"}}},
        {"properties": {"predicate": {"const": "region"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/region"}}},
        {"properties": {"predicate": {"const": "cadence"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/cadence"}}},
        {"properties": {"predicate": {"const": "model"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/model"}}},
        {"properties": {"predicate": {"const": "variable"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/variable"}}},
        {"properties": {"predicate": {"const": "directObservation"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/directObservation"}}},
        {"properties": {"predicate": {"const": "nativeResolutionM"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/nativeResolutionM"}}},
        {"properties": {"predicate": {"const": "interpolated"}, "value": {"$ref": "../seams/fe-core.yaml#/components/schemas/SearchEvidenceFacts/properties/interpolated"}}}
      ]
    },
    "RuleBasis": {
      "type": "object", "additionalProperties": false, "required": ["mapping_rule_id"],
      "properties": {"mapping_rule_id": {"$ref": "#/$defs/Version"}}
    },
    "ReviewBasis": {
      "type": "object", "additionalProperties": false, "required": ["review_id"],
      "properties": {"review_id": {"$ref": "#/$defs/Id"}}
    },
    "Mapping": {
      "type": "object", "additionalProperties": false, "required": ["fact_id", "concept_id", "basis"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/Id"}, "concept_id": {"$ref": "#/$defs/ConceptId"},
        "basis": {"oneOf": [{"$ref": "#/$defs/RuleBasis"}, {"$ref": "#/$defs/ReviewBasis"}]}
      }
    },
    "SourceDependency": {
      "type": "object", "additionalProperties": false, "required": ["owner", "resource_id", "revision"],
      "properties": {
        "owner": {"enum": ["D3", "D4", "D5"]}, "resource_id": {"$ref": "#/$defs/Id"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "OntologyDependency": {
      "type": "object", "additionalProperties": false, "required": ["owner", "resource_id", "revision"],
      "properties": {
        "owner": {"const": "D9"},
        "resource_id": {"$ref": "../seams/core-ai.yaml#/components/schemas/OntologyManifest/properties/entries/propertyNames"},
        "revision": {"$ref": "#/$defs/Digest"}
      }
    },
    "Dependency": {"oneOf": [{"$ref": "#/$defs/SourceDependency"}, {"$ref": "#/$defs/OntologyDependency"}]},
    "SourceGrant": {"type": "string", "minLength": 1, "maxLength": 512, "description": "Opaque secret handle; never log."},
    "ReplaceCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "grant", "source_key", "source_version", "processing_version", "facts", "mappings", "dependencies"],
      "properties": {
        "protocol": {"const": "knowledge-lifecycle/1"}, "grant": {"$ref": "#/$defs/SourceGrant"},
        "source_key": {"$ref": "#/$defs/SourceKey"}, "source_version": {"$ref": "#/$defs/SourceVersion"},
        "processing_version": {"$ref": "#/$defs/ProcessingVersion"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/Evidence"}},
        "mappings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Mapping"}},
        "dependencies": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Dependency"}}
      }
    },
    "KnowledgePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "source_key", "source_version", "processing_version", "facts", "mappings", "dependencies"],
      "properties": {
        "protocol": {"const": "knowledge-lifecycle/1"},
        "source_key": {"$ref": "#/$defs/SourceKey"}, "source_version": {"$ref": "#/$defs/SourceVersion"},
        "processing_version": {"$ref": "#/$defs/ProcessingVersion"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/Evidence"}},
        "mappings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Mapping"}},
        "dependencies": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Dependency"}}
      }
    },
    "DeletedSourceVersion": {
      "type":"object", "additionalProperties":false, "required":["revision","deleted"],
      "properties":{"revision":{"type":"integer","minimum":1},"deleted":{"const":true}}
    },
    "DeletionProcessingVersion": {
      "type":"object", "additionalProperties":false, "required":["generation"],
      "properties":{"generation":{"type":"integer","minimum":1}}
    },
    "InvalidateCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "grant", "source_key", "source_version", "processing_version", "reason"],
      "properties": {
        "protocol": {"const": "knowledge-lifecycle/1"}, "grant": {"$ref": "#/$defs/SourceGrant"},
        "source_key": {"$ref": "#/$defs/SourceKey"}, "source_version": {"$ref": "#/$defs/DeletedSourceVersion"},
        "processing_version": {"$ref": "#/$defs/DeletionProcessingVersion"},
        "reason": {"const":"deleted"}
      }
    },
    "DeletionIssueRequest": {
      "type":"object", "additionalProperties":false,"required":["source_key","expected_revision"],
      "properties":{"source_key":{"$ref":"#/$defs/SourceKey"},"expected_revision":{"type":"integer","minimum":1}}
    },
    "DeletionValidateRequest": {
      "type":"object","additionalProperties":false,"required":["command"],
      "properties":{"command":{"$ref":"#/$defs/InvalidateCommand"}}
    },
    "DeletionValidateResponse": {
      "type":"object","additionalProperties":false,"required":["status"],
      "properties":{"status":{"enum":["current","forbidden","stale_source","stale_generation"]}}
    },
    "InvalidationReceipt": {
      "type":"object","additionalProperties":false,
      "required":["protocol","issuer","receipt_id","source_key","source_version","processing_version","publication_sequence","payload_digest","status"],
      "properties":{
        "protocol":{"const":"knowledge-lifecycle/1"},"issuer":{"const":"D9"},
        "receipt_id":{"$ref":"#/$defs/Id"},"source_key":{"$ref":"#/$defs/SourceKey"},
        "source_version":{"$ref":"#/$defs/DeletedSourceVersion"},
        "processing_version":{"$ref":"#/$defs/DeletionProcessingVersion"},
        "publication_sequence":{"type":"integer","minimum":1},"payload_digest":{"$ref":"#/$defs/Digest"},
        "status":{"const":"invalidated"}
      }
    },
    "SourceIssueRequest": {
      "type":"object", "additionalProperties":false, "required":["source_key"],
      "properties":{"source_key":{"$ref":"#/$defs/SourceKey"}}
    },
    "SourceIssueResponse": {
      "type":"object", "additionalProperties":false, "required":["command","principal"],
      "properties":{"command":{"$ref":"#/$defs/ReplaceCommand"},"principal":{"$ref":"#/$defs/Principal"}}
    },
    "SourceValidateRequest": {
      "type":"object", "additionalProperties":false, "required":["command"],
      "properties":{"command":{"$ref":"#/$defs/ReplaceCommand"}}
    },
    "SourceValidateResponse": {
      "type":"object", "additionalProperties":false, "required":["status","principal"],
      "properties":{"status":{"enum":["current","forbidden","stale_source","stale_generation","stale_release"]},"principal":{"$ref":"#/$defs/Principal"}}
    },
    "KnowledgeReplaceRequest": {
      "type":"object", "additionalProperties":false, "required":["command","principal"],
      "properties":{"command":{"$ref":"#/$defs/ReplaceCommand"},"principal":{"$ref":"#/$defs/Principal"}}
    },
    "KnowledgeReceipt": {
      "description": "Issuer field is routing metadata, not a signature. Read over trusted authenticated adapter and validate against source authority.",
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "issuer", "receipt_id", "source_key", "source_version", "processing_version", "publication_sequence", "payload_digest", "status"],
      "properties": {
        "protocol": {"const": "knowledge-lifecycle/1"}, "issuer": {"const": "D9"},
        "receipt_id": {"$ref": "#/$defs/Id"}, "source_key": {"$ref": "#/$defs/SourceKey"},
        "source_version": {"$ref": "#/$defs/SourceVersion"}, "processing_version": {"$ref": "#/$defs/ProcessingVersion"},
        "publication_sequence": {"type": "integer", "minimum": 1}, "payload_digest": {"$ref": "#/$defs/Digest"},
        "status": {"enum": ["replaced", "invalidated"]}
      }
    },
    "SourceReadRequest": {
      "type":"object", "additionalProperties":false, "required":["receipt"],
      "properties":{"receipt":{"$ref":"#/$defs/KnowledgeReceipt"}}
    },
    "KnowledgeReadRequest": {
      "type":"object", "additionalProperties":false, "required":["source_key","expected_receipt_id"],
      "properties":{"source_key":{"$ref":"#/$defs/SourceKey"},"expected_receipt_id":{"$ref":"#/$defs/Id"}}
    },
    "AuthorizedKnowledge": {
      "description":"Returned only after current viewer authorization. Payload, receipt and computed digest must agree.",
      "type":"object", "additionalProperties":false, "required":["payload","receipt"],
      "properties":{"payload":{"$ref":"#/$defs/KnowledgePayload"},"receipt":{"$ref":"#/$defs/KnowledgeReceipt"}}
    }
  }
}
